{
  "name": "@vault/nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"lib/**/*.ts\" \"scripts/**/*.ts\"",
    "check-types": "tsc --noEmit",
    "demo:attest": "tsx --env-file=../../.env scripts/demo-attest.ts",
    "demo:topic": "tsx --env-file=../../.env scripts/demo-topic.ts",
    "verify:proof": "tsx scripts/verify-proof.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@hashgraph/sdk": "^2.60.0",
    "@vault/ledger": "*",
    "dotenv": "^16.4.5",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20.18.3"
  },
  "license": "MIT"
}
