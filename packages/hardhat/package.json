{
  "name": "@vault/hardhat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "account:generate": "node -e \"console.log('Set HEDERA_EVM_PRIVATE_KEY or use portal keys; no local account task in this thin template.')\"",
    "compile": "hardhat compile",
    "deploy": "hardhat deploy",
    "test": "hardhat test",
    "lint": "hardhat compile && solhint \"contracts/**/*.sol\" --max-warnings 0 && tsc --noEmit",
    "format": "prettier --write \"contracts/**/*.sol\" \"deploy/**/*.ts\" \"test/**/*.ts\" \"hardhat.config.ts\"",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "@vault/ledger": "*"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.9",
    "@types/node": "^20.17.0",
    "chai": "^4.5.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.15",
    "hardhat-deploy": "^0.14.0",
    "prettier": "^3.3.3",
    "prettier-plugin-solidity": "^1.4.1",
    "solhint": "^5.0.3",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.18.3"
  },
  "license": "MIT"
}
