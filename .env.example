# Hedera operator (testnet). Get HBAR: https://portal.hedera.com/faucet
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=

# HCS topic that stores vault attestations (create via UI or yarn demo:topic)
HCS_TOPIC_ID=

# Mirror Node REST (public Hashio default for testnet)
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# IPFS provider: kubo (default, local HTTP API) | pinata (HTTP pinning API)
IPFS_PROVIDER=kubo
# Kubo HTTP API (used when IPFS_PROVIDER=kubo). Without IPFS the vault has nowhere for bytes.
IPFS_API_URL=http://127.0.0.1:5001
# Public gateway used for "fetch from IPFS" links
IPFS_GATEWAY_URL=https://ipfs.io/ipfs
# Pinata (when IPFS_PROVIDER=pinata). Prefer JWT; never commit secrets.
# PINATA_JWT=
# Or legacy key pair:
# PINATA_API_KEY=
# PINATA_API_SECRET=

# Optional pin fee (HIP-336). Leave unset for free attestation (HBAR network fee only).
PIN_TOKEN_ID=
# Use HBAR or 0.0.0 for native HBAR pin fee (tinybars in PIN_FEE_AMOUNT).
# Or set an HTS token id for HIP-336 allowance + CryptoTransfer.
PIN_FEE_AMOUNT=
PIN_TREASURY_ACCOUNT_ID=
PIN_FEE_CONTRACT_ADDRESS=

# Next.js public mirrors (safe to expose)
NEXT_PUBLIC_HEDERA_NETWORK=testnet
NEXT_PUBLIC_HCS_TOPIC_ID=
NEXT_PUBLIC_IPFS_GATEWAY_URL=https://ipfs.io/ipfs
NEXT_PUBLIC_HASHSCAN_BASE=https://hashscan.io/testnet
NEXT_PUBLIC_PIN_TOKEN_ID=
# Use HBAR or 0.0.0 for native HBAR pin fee (tinybars in PIN_FEE_AMOUNT).
# Or set an HTS token id for HIP-336 allowance + CryptoTransfer.
NEXT_PUBLIC_PIN_FEE_AMOUNT=
NEXT_PUBLIC_PIN_TREASURY_ACCOUNT_ID=
NEXT_PUBLIC_PIN_FEE_CONTRACT_ADDRESS=
